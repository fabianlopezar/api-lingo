# Copia a .env y completa. Nunca commitees .env con valores reales.
PORT=3000
NODE_ENV=development

# DB (opción 1: URL completa - recomendado)
DATABASE_URL=postgresql://postgres.xxx:TU_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# DB (opción 2: construida desde Supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# DB_PASSWORD="tu_password_con_caracteres_especiales_entre_comillas"
# DB_USER=postgres.xxx
# DB_HOST=aws-1-us-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USE_POOLER=true
# SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com

# Auth (obligatorio en prod, >=32 chars)
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio-de-32-plus
# JWT_EXPIRES_IN=24h

# Google OAuth (login con Google → POST /api/auth/google con { idToken })
# Se crea en Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Puedes poner varios separados por coma (dev + prod).
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# CORS (obligatorio en prod: tu dominio frontend, sin trailing slash)
# En dev se puede dejar vacío para permitir localhost
CORS_ORIGIN=http://localhost:5173

# Supabase (solo referencia, no secreto de servicio)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# IA / ilustraciones (opcionales)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# ILLUSTRATION_PROVIDER=auto
# POLLINATIONS_MODEL=flux
# POLLINATIONS_SIZE=1024
# OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Cloudinary (opcional)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
